[Unit]
Description=Timer für den Failed-Unit-Wächter (2x täglich)

[Timer]
# Morgens nach den Nacht-Jobs (Backups laufen 03:15–03:35, Gates bis ~06:00)
# und abends. Der Wächter meldet nur bei Änderung, zwei Läufe kosten also
# nichts und halbieren die Zeit, in der ein Ausfall unbemerkt bleibt.
OnCalendar=*-*-* 07:45:00
OnCalendar=*-*-* 19:45:00
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
