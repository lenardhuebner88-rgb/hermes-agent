[Unit]
Description=Hermes observability end-to-end sentinel
Documentation=file:/home/piet/.hermes/hermes-agent/scripts/observability_sentinel_smoke.WIRING.md
ConditionUser=piet

[Service]
Type=oneshot
WorkingDirectory=/home/piet/.hermes/hermes-agent
ExecStart=/home/piet/.hermes/hermes-agent/.venv/bin/python /home/piet/.hermes/hermes-agent/scripts/observability_sentinel_smoke.py
TimeoutStartSec=120
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/data/hermes-observability
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
