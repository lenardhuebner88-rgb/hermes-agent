<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay measurement tokens. The layouts and OverlayGeometry must not carry their own copies;
     OverlayGeometryTokenTest asserts the Kotlin constants still match the values below. -->
<resources>
    <!-- Touch and shape -->
    <dimen name="overlay_touch_target">48dp</dimen>
    <dimen name="overlay_icon_inset">12dp</dimen>
    <dimen name="overlay_elevation">10dp</dimen>
    <dimen name="overlay_stroke">1dp</dimen>

    <!-- Pill frame -->
    <dimen name="pill_height">64dp</dimen>
    <dimen name="pill_padding_horizontal">8dp</dimen>
    <dimen name="pill_column_margin">10dp</dimen>
    <dimen name="pill_column_min_width">132dp</dimen>
    <!-- Gap between two adjacent action buttons. Only the content column carried margins, so
         once the rest-state capsule collapsed that column to zero the undo and confirm buttons
         sat flush against each other. -->
    <dimen name="pill_action_gap">8dp</dimen>
    <dimen name="pill_wave_height">28dp</dimen>

    <!-- Bubble -->
    <dimen name="bubble_size">48dp</dimen>
    <dimen name="bubble_ring">2dp</dimen>

    <!-- Type scale -->
    <dimen name="overlay_text_status">11sp</dimen>
    <dimen name="overlay_text_body">15sp</dimen>
</resources>
