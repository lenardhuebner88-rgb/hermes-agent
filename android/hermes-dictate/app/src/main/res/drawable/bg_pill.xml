<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded dictation pill: a deep, slightly lifted capsule that sits above any app without
     competing with it. The gradient is barely perceptible and only gives the surface a top edge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/overlay_surface_top"
        android:endColor="@color/overlay_surface" />
    <stroke android:width="@dimen/overlay_stroke" android:color="@color/overlay_border" />
    <corners android:radius="999dp" />
</shape>
