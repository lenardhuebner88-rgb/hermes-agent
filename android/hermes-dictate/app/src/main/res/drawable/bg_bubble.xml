<?xml version="1.0" encoding="utf-8"?>
<!-- Idle bubble: a dark disc with an accent-tinted ring. The ring is what makes it read as a
     control rather than as a stray dot, and it keeps the mic legible on light wallpapers. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="270"
        android:startColor="@color/overlay_surface_top"
        android:endColor="@color/overlay_surface" />
    <stroke android:width="@dimen/bubble_ring" android:color="@color/bubble_ring" />
</shape>
