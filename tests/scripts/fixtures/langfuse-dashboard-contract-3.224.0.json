{
  "contract_version": 1,
  "source": {
    "repository": "langfuse/langfuse",
    "langfuse_version": "3.224.0",
    "revision": "d044f366816282235898a0673d5700e05ccbee8c",
    "files": [
      "packages/shared/src/features/query/dataModel.ts",
      "packages/shared/src/interfaces/filters.ts",
      "web/src/features/widgets/components/WidgetForm.tsx",
      "web/src/features/widgets/utils.ts"
    ]
  },
  "supported_chart_types": [
    "BAR_TIME_SERIES",
    "HISTOGRAM",
    "HORIZONTAL_BAR",
    "LINE_TIME_SERIES",
    "NUMBER",
    "PIE",
    "PIVOT_TABLE",
    "VERTICAL_BAR"
  ],
  "chart_config_fields": {
    "BAR_TIME_SERIES": ["type"],
    "HISTOGRAM": ["bins", "type"],
    "HORIZONTAL_BAR": ["row_limit", "type"],
    "LINE_TIME_SERIES": ["type"],
    "NUMBER": ["row_limit", "type"],
    "PIE": ["row_limit", "type"],
    "PIVOT_TABLE": ["defaultSort", "row_limit", "type"],
    "VERTICAL_BAR": ["row_limit", "type"]
  },
  "filter_operators": {
    "arrayOptions": ["all of", "any of", "none of"],
    "string": ["=", "contains", "does not contain", "ends with", "starts with"]
  },
  "views": {
    "observations": {
      "dimensions": ["providedModelName", "tags"],
      "metrics": {
        "count": ["count"],
        "latency": ["avg", "max", "p50", "p95"],
        "timeToFirstToken": ["avg", "max", "p50", "p95"],
        "totalCost": ["avg", "p50", "p95", "sum"]
      }
    },
    "scores-boolean": {
      "dimensions": ["booleanValue", "name"],
      "metrics": {
        "count": ["count"],
        "value": ["avg", "p50", "p95"]
      }
    },
    "scores-categorical": {
      "dimensions": ["name", "stringValue"],
      "metrics": {
        "count": ["count"]
      }
    },
    "scores-numeric": {
      "dimensions": ["name", "value"],
      "metrics": {
        "count": ["count"],
        "value": ["avg", "histogram", "max", "min", "p50", "p95", "sum"]
      }
    },
    "traces": {
      "dimensions": ["tags"],
      "metrics": {
        "count": ["count"]
      }
    }
  }
}
